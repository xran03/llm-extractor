# Copy to .env and fill in. NEVER commit the real .env.
#
# Two API backends are supported. Configure the one(s) you use.
#
# You can skip this file entirely: `llm-extract login` asks for the key with
# hidden input, verifies it, and saves it outside the project in a file only
# you can read. That is the recommended route on a personal machine.
# For a single run without saving anything:
#   llm-extract -i docs -o out --api llmhub --api-key -

# ---------------------------------------------------------------------------
# Backend 1: llmhub  (OpenAI-compatible /v1/chat/completions)
# ---------------------------------------------------------------------------
LLM_HUB_BASE_URL=https://your-llmhub-host
# Auth option A: long-lived API key
LLM_HUB_API_KEY=
# Auth option B: OAuth2 client credentials (a short-lived bearer token is minted)
LLM_HUB_CLIENT_ID=
LLM_HUB_CLIENT_SECRET=
LLM_HUB_TOKEN_URL=

# ---------------------------------------------------------------------------
# Backend 2: aimodelhub  (OpenAI-compatible /v1/responses)
# ---------------------------------------------------------------------------
AI_MODEL_HUB_BASE_URL=https://your-aimodelhub-host
AI_MODEL_HUB_API_KEY=
AI_MODEL_HUB_CLIENT_ID=
AI_MODEL_HUB_CLIENT_SECRET=
AI_MODEL_HUB_TOKEN_URL=

# ---------------------------------------------------------------------------
# Optional global defaults
# ---------------------------------------------------------------------------
LLM_EXTRACTOR_API=llmhub
LLM_EXTRACTOR_MODEL=
LLM_EXTRACTOR_OCR_MODEL=
LLM_EXTRACTOR_CACHE_DIR=
